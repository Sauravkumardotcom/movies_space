{
  "name": "movies-space-backend",
  "version": "1.0.0",
  "description": "Backend server for Movies Space streaming platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node db/init.js",
    "prisma:generate": "npx prisma generate --schema ../prisma/schema.prisma",
    "prisma:db:push": "npx prisma db push --schema ../prisma/schema.prisma",
    "prisma:studio": "npx prisma studio --schema ../prisma/schema.prisma",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "axios": "^1.13.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.0.0",
    "express-validator": "^7.3.2",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.2",
    "mongoose": "^7.5.0"
  },
  "devDependencies": {
    "prisma": "^6.15.0",
    "supertest": "^6.3.3",
    "vitest": "^1.0.4"
  }
}
